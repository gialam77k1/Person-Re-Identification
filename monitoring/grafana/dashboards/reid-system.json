      "id": 2,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}},
      "targets": [{"expr": "100 * sum(rate(reid_api_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(reid_api_requests_total[5m])), 0.000001)", "legendFormat": "5xx error rate", "refId": "A"}],
      "title": "API error rate",
      "type": "timeseries"
    },
    {
