      "id": 6,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [{"expr": "sum by (outcome) (rate(reid_search_queries_total[5m]))", "legendFormat": "{{outcome}}", "refId": "A"}],
