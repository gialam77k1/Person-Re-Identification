      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"custom": {"fillOpacity": 70, "hideFrom": {"legend": false, "tooltip": false, "viz": false}, "scaleDistribution": {"type": "linear"}}}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 14},
      "id": 7,
      "options": {"calculate": false, "cellGap": 1, "color": {"scheme": "Spectral"}, "legend": {"show": true}},
      "targets": [{"expr": "sum by (le) (rate(reid_similarity_score_bucket[5m]))", "format": "heatmap", "legendFormat": "{{le}}", "refId": "A"}],
