# Copy this file to .env.mlops and replace every change-me value before starting the stack.

# PostgreSQL / MLflow backend store
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=mlflow
POSTGRES_PORT=5432

# MinIO / S3-compatible object storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MLFLOW_ARTIFACT_BUCKET=mlflow-artifacts
DVC_BUCKET=dvc-storage

# MLflow uses the same MinIO credentials in the local stack.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=change-me-minio-password
AWS_DEFAULT_REGION=us-east-1
MLFLOW_S3_ENDPOINT_URL=http://minio:9000
MLFLOW_PORT=5000
