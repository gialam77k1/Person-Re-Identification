# Copy this file to .env.mlops and replace every change-me value before starting the stack.
DOCKER_CONTEXT=default

# PostgreSQL / MLflow backend store
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=mlflow
POSTGRES_PORT=15432

# MinIO / S3-compatible object storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MLFLOW_ARTIFACT_BUCKET=mlflow-artifacts
DVC_BUCKET=dvc-storage

# MLflow uses the same MinIO credentials in the local stack.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=change-me-minio-password
AWS_DEFAULT_REGION=us-east-1
MLFLOW_S3_ENDPOINT_URL=http://minio:9000
MLFLOW_PORT=5000
# Client-side URI used by local training and release publishing.
MLFLOW_TRACKING_URI=http://localhost:5000

# Qdrant vector database. Keep the current bind mount to preserve indexed vectors.
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_STORAGE_PATH=./artifacts/qdrant/storage

# Triton inference server. This release requires a working NVIDIA Container Toolkit.
TRITON_MODEL_REPOSITORY=./artifacts/triton/market1501-vit-bnneck-v1/model_repository
TRITON_HTTP_PORT=8000
TRITON_GRPC_PORT=8001
TRITON_METRICS_PORT=8002
TRITON_SHM_SIZE=1g
TRITON_LOG_VERBOSE=0
TRITON_NVIDIA_VISIBLE_DEVICES=0

# FastAPI online inference service
API_PORT=8080
API_MODEL_MANIFEST_PATH=artifacts/pipeline/market1501-vit-bnneck-v1-dvc/release/model_manifest.json
QDRANT_COLLECTION=reid_reference_v1
TRITON_MODEL_NAME=reid_embedding
TRITON_MODEL_VERSION=1
API_TRITON_MODEL_REPOSITORY=artifacts/pipeline/market1501-vit-bnneck-v1-dvc/triton/model_repository
API_MAX_UPLOAD_BYTES=10485760
API_MAX_IMAGE_PIXELS=25000000
API_DEFAULT_TOP_K=5
API_MAX_TOP_K=100
API_UPSTREAM_TIMEOUT_SECONDS=30
API_MATCH_THRESHOLD=0.5

# Deployment history must live outside the Git checkout so rollback survives actions/checkout cleanup.
DEPLOYMENT_STATE_ROOT=../person-reid-deployments

# Monitoring
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=30d
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3000
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-grafana-password
MONITORING_STORAGE_PATH=../person-reid-monitoring
API_DRIFT_SAMPLE_RATE=0.05
API_DRIFT_MAX_SAMPLES=10000

# MLOps Control Center. Use a fine-grained token with Actions: read/write only.
CONTROL_API_PORT=8090
CONTROL_UI_PORT=3001
CONTROL_GITHUB_REPOSITORY=gialam77k1/Person-Re-Identification
CONTROL_GITHUB_TOKEN=change-me-github-actions-token
CONTROL_WORKFLOW_REF=main
CONTROL_CALLBACK_TOKEN=change-me-long-random-callback-token
CONTROL_ALLOWED_DATASETS=dukemtmc-reid
CONTROL_HOST_DATASET_ROOT=/absolute/path/to/Person-Re-Identification/datasets
CONTROL_INBOX_MIN_VALID_IMAGES=1000
CONTROL_INBOX_MIN_IDENTITIES=50
CONTROL_INBOX_MIN_CAMERAS=2
CONTROL_INBOX_SOURCE_RELEASE=market1501-vit-bnneck:v1-dvc
CONTROL_INBOX_TARGET_RELEASE=market1501-duke-vit-bnneck:v2
CONTROL_PUBLIC_MLFLOW_URL=http://localhost:5000
CONTROL_PUBLIC_GRAFANA_URL=http://localhost:3000
CONTROL_PUBLIC_MINIO_URL=http://localhost:9001
CONTROL_PUBLIC_QDRANT_URL=http://localhost:6333/dashboard
CONTROL_PUBLIC_TRITON_URL=http://localhost:8000/v2
CONTROL_PUBLIC_INFERENCE_API_URL=http://localhost:8080/docs
CONTROL_PUBLIC_GITHUB_ACTIONS_URL=https://github.com/gialam77k1/Person-Re-Identification/actions
